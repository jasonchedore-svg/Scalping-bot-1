# Copy to .env and fill in paper keys. Never commit .env.
# Free paper account: https://app.alpaca.markets/signup

# --- Safety (defaults are paper-only) ---
PAPER=true
ALLOW_LIVE_TRADING=false

# --- Alpaca paper API ---
# Paper dashboard: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Force the local simulator even if keys are present (useful for demos).
FORCE_SIMULATOR=false

# --- Universe ---
# Stocks: ticker. Crypto: Alpaca pair (BTC/USD).
WATCHLIST=AAPL,MSFT,NVDA,SPY,QQQ,BTC/USD,ETH/USD

# --- Loop ---
POLL_INTERVAL_SECONDS=10
BAR_TIMEFRAME=1Min
BAR_LOOKBACK=120
DRY_RUN=false
LOG_LEVEL=INFO
LOG_JSON=false
STATE_DIR=data

# --- Risk (scalping defaults; no margin/leverage/options) ---
MAX_POSITION_NOTIONAL=2000
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=20
COOLDOWN_SECONDS=90
RISK_PER_TRADE_PCT=0.004
ALLOW_FRACTIONAL_SHARES=true
ALLOW_SHORT=false
ALLOW_MARGIN=false

# --- Strategy ---
STRATEGY=momentum_scalp
STOP_ATR_MULT=1.0
TAKE_PROFIT_ATR_MULT=1.5
MAX_HOLD_MINUTES=20
USE_5M_TREND_FILTER=true
ENTRY_CUTOFF_ET=15:40
FLATTEN_ET=15:50
